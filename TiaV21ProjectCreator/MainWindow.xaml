<Window x:Class="TiaV21ProjectCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TIA Portal V21 - Proje Oluşturucu" Height="260" Width="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Proje Adı" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtProjectName" Text="Test_Proje_V21" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="Hedef Klasör" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <DockPanel>
                <Button x:Name="BtnBrowse" Content="Gözat..." Width="80" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                <TextBox x:Name="TxtTargetPath" Text="C:\TIA_Projects" Padding="6"/>
            </DockPanel>
        </StackPanel>

        <Button x:Name="BtnCreateProject" Grid.Row="2" Content="TIA Portal'da Proje Oluştur"
                Height="36" FontWeight="SemiBold" Click="BtnCreateProject_Click"/>

        <TextBlock x:Name="TxtStatus" Grid.Row="3" Margin="0,12,0,0"
                   TextWrapping="Wrap" Foreground="#333333"/>
    </Grid>
</Window>